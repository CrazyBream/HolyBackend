                <span class="relic-Metric-badge">RLS SECURED</span>
                <svg class="blueprint-svg" viewBox="0 0 260 120" xmlns="http://www.w3.org/2000/svg">
                    <path d="M 130 16 L 175 34 L 175 68 C 175 90 130 106 130 106 C 130 106 85 90 85 68 L 85 34 Z" fill="rgba(56,189,248,0.08)" stroke="#38bdf8" stroke-width="1.8" />
                    <line x1="130" y1="42" x2="130" y2="78" stroke="#f3d088" stroke-width="2.5" />
                    <line x1="112" y1="60" x2="148" y2="60" stroke="#f3d088" stroke-width="2.5" />
                </svg>
            </div>
            <div class="relic-body">
                <div class="relic-stack">.NET 8 • PostgreSQL RLS • Clean Arch</div>
