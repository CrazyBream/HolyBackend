    </div>

    <div class="exorcism-comparison-box">
        <div>
            <div class="relic-crest-line">Transformatio Codicis</div>
            <h3 style="font-family: 'Cormorant Unicase', 'Cinzel', serif; font-size: 1.65rem; color: var(--gold-bright); margin-bottom: 0.4rem;">
                Інтерактивний Стенд: До та Після Екзорцизму
            </h3>
            <p style="font-size: 0.86rem; color: #a1a1aa; line-height: 1.6;">
                Переміщуйте повзунок освячення коду, щоб побачити, як сирий моноліт із технічним боргом перетворюється на швидкодійну архітектуру Ордену.
            </p>

            <div class="audit-slider-wrap">
                <div style="display: flex; justify-content: space-between; font-family: 'Cinzel', serif; font-size: 0.78rem; margin-bottom: 6px;">
                    <span style="color: #f87171;">0% (Грішний Легасі)</span>
                    <span id="sanctifyPercentLabel" style="color: var(--accent-blue); font-weight: 700;">Рівень освячення: 100%</span>
                    <span style="color: #4ade80;">100% (Канон Ордену)</span>
                </div>
                <input type="range" min="0" max="100" value="100" class="audit-range" id="sanctifyRange" oninput="updateExorcismDemo(this.value)" />
            </div>
        </div>

        <div class="telemetry-comparison-grid">
            <div class="telemetry-box">
                <div style="font-size: 0.72rem; color: #9ca3af; text-transform: uppercase;">Час відповіді БД (SQL Latency)</div>
                <div id="demoLatency" style="font-family: 'Cinzel', serif; font-size: 1.55rem; color: #4ade80; font-weight: 700; margin: 4px 0;">14 ms</div>
                <div id="demoLatencySub" style="font-size: 0.74rem; color: #a1a1aa;">Пулінг Supavisor + Індекси</div>
            </div>

            <div class="telemetry-box">
                <div style="font-size: 0.72rem; color: #9ca3af; text-transform: uppercase;">Кількість необроблених збоїв</div>
                <div id="demoExceptions" style="font-family: 'Cinzel', serif; font-size: 1.55rem; color: var(--gold-bright); font-weight: 700; margin: 4px 0;">0 Exceptions</div>
                <div id="demoExceptionsSub" style="font-size: 0.74rem; color: #a1a1aa;">FluentValidation + EnableRetry</div>
            </div>
        </div>
    </div>
</div>

<div class="inspect-backdrop" id="inspectBackdrop" onclick="if(event.target === this) closeInspectModal()">
    <div class="inspect-modal">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;">
            <div>
                <div id="modalTag" style="font-family: 'Fira Code', monospace; font-size: 0.75rem; color: var(--accent-blue); letter-spacing: 2px;">ARTIFACT SPECIFICATION</div>
                <h2 id="modalTitle" style="font-family: 'Cormorant Unicase', 'Cinzel', serif; font-size: 1.85rem; color: var(--gold-bright);">Назва Проєкту</h2>
            </div>
            <button type="button" onclick="closeInspectModal()" style="background: none; border: 1px solid rgba(201,162,94,0.35); color: #d4d4d8; width: 34px; height: 34px; border-radius: 50%; cursor: pointer;">✕</button>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 1rem;">
            <div style="background: rgba(20, 10, 14, 0.75); border: 1px solid rgba(248, 113, 113, 0.3); border-radius: 10px; padding: 0.9rem;">
                <div style="font-family: 'Cinzel', serif; font-size: 0.75rem; color: #f87171; margin-bottom: 4px;">ВИКЛИК (ПОЧАТКОВИЙ ГРІХ)</div>
                <p id="modalChallenge" style="font-size: 0.83rem; color: #e4e4e7; line-height: 1.5;"></p>
            </div>
            <div style="background: rgba(10, 20, 16, 0.75); border: 1px solid rgba(74, 222, 128, 0.3); border-radius: 10px; padding: 0.9rem;">
                <div style="font-family: 'Cinzel', serif; font-size: 0.75rem; color: #4ade80; margin-bottom: 4px;">РІШЕННЯ ОРДЕНУ</div>
                <p id="modalSolution" style="font-size: 0.83rem; color: #e4e4e7; line-height: 1.5;"></p>
            </div>
        </div>

        <div style="font-family: 'Cinzel', serif; font-size: 0.75rem; color: var(--primary-gold); letter-spacing: 1px;">ФРАГМЕНТ ОСВЯЧЕНОГО ЯДРА:</div>
        <div class="inspect-code-block" id="modalCode"></div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div id="modalMetrics" style="font-family: 'Fira Code', monospace; font-size: 0.8rem; color: var(--accent-blue);"></div>
            <div style="display: flex; gap: 0.8rem;">
                <button type="button" class="btn-danger btn-sm" onclick="closeInspectModal()">Закрити сувій</button>
                @if (!isAdmin)
                {
                    <a asp-controller="Orders" asp-action="Create" class="btn-ritual btn-sm">Замовити аналогічну архітектуру →</a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('mousemove', (e) => {
            document.querySelectorAll('.relic-card').forEach(card => {
                const rect = card.getBoundingClientRect();
                card.style.setProperty('--rx', `${e.clientX - rect.left}px`);
                card.style.setProperty('--ry', `${e.clientY - rect.top}px`);
            });
        });
        function filterRelics(category, btn) {
            document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('.relic-card').forEach(card => {
                const cats = card.getAttribute('data-category') || '';
                if (category === 'all' || cats.includes(category)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }
      
        function updateExorcismDemo(val) {
            const pct = parseInt(val, 10);
            document.getElementById('sanctifyPercentLabel').textContent = `Рівень освячення: ${pct}%`;

                                        
            const latency = Math.round(680 - (pct * 6.66));
            const exceptions = Math.round((100 - pct) * 0.42);

            const latEl = document.getElementById('demoLatency');
            const excEl = document.getElementById('demoExceptions');

            latEl.textContent = `${latency} ms`;
            latEl.style.color = pct > 60 ? '#4ade80' : (pct > 30 ? '#facc15' : '#f87171');

            excEl.textContent = `${exceptions} Exceptions`;
            excEl.style.color = exceptions === 0 ? 'var(--gold-bright)' : '#f87171';
        }

              
      
        const portfolioSpecs = [
            {
                tag: "ARTIFACT #I • .NET 8 MVC & SUPABASE",
                title: "Sanctuary Corporate Portal",
                challenge: "Стандартні корпоративні сайти виглядають шаблонно, а прямі виклики БД у контролерах унеможливлюють масштабування.",
                solution: "Трирівнева Clean Architecture (Core, DAL, MVC) із патернами Strategy, Factory, Observer та інтерактивним 3D-вівтарем на чистій векторній графіці.",
                code: "public async Task<Order> CreateOrderAsync(string title, string desc, OrderType type, string clientId)\n{\n    var order = _orderFactory.CreateOrder(title, desc, type, clientId);\n    await _orderValidator.ValidateAndThrowAsync(order);\n    await _unitOfWork.Orders.AddAsync(order);\n    await _unitOfWork.SaveChangesAsync();\n    return order;\n}",
                metrics: "Uptime: 99.98% | Lighthouse UI: 98/100 | 0 SQL Leaks"
            },
            {
                tag: "ARTIFACT #II • HIGHLOAD E-COMMERCE",
                title: "Mercantile Cathedral E-Commerce",
                challenge: "Втрата замовлень під час пікових навантажень та розсинхронізація складських залишків при одночасній оплаті.",
                solution: "Впроваджено патерн Unit of Work із явними транзакціями BeginTransactionAsync / CommitTransactionAsync та пулінгом з'єднань PostgreSQL.",
                code: "await _unitOfWork.BeginTransactionAsync();\ntry {\n    await _unitOfWork.Orders.AddAsync(order);\n    await _unitOfWork.CommitTransactionAsync();\n} catch {\n    await _unitOfWork.RollbackTransactionAsync();\n    throw;\n}",
                metrics: "Throughput: 12,500 tx/min | ACID Compliance: 100%"
            },
            {
                tag: "ARTIFACT #III • INTERACTIVE UI/UX",
                title: "Chronicles of Void Lore Portal",
                challenge: "Важкі растрові ілюстрації гальмували завантаження сторінки та виглядали розмито на Retina-екранах.",
                solution: "Повний перехід на багатошарову параметричну SVG-графіку з 3D-паралаксом у реальному часі за координатами курсора.",
                code: "const rotX = ((e.clientY - innerHeight / 2) / (innerHeight / 2)) * -12;\nconst rotY = ((e.clientX - innerWidth / 2) / (innerWidth / 2)) * 12;\nartifact.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;",
                metrics: "Frame Rate: 60 FPS | Завантаження першого екрана: 0.4s"
            },
            {
                tag: "ARTIFACT #IV • TELEMEDICINE PLATFORM",
                title: "Aegis Telemedicine Sanctuary",
                challenge: "Суворі вимоги до конфіденційності медичних консультацій та ризик блокування проєкту у випадку зміни хмарного провайдера.",
                solution: "Чиста доменна модель за інверсією залежностей (DIP) з розмежуванням прав доступу на рівні рядків БД та криптографічною верифікацією.",
                code: "RuleFor(x => x.Text)\n    .NotEmpty()\n    .MaximumLength(1000)\n    .Must(NotContainHeresyOrInjections)\n    .WithMessage(\"Виявлено спробу ін'єкції або заборонений код!\");",
                metrics: "Security Audit: Passed | Architecture: Vendor-Agnostic"
            },
            {
                tag: "ARTIFACT #V • ENTERPRISE DATABASE",
                title: "AquaFlow Municipal Telemetry",
                challenge: "Повільна побудова ієрархічних звітів по інженерних вузлах міста (понад 4.5 секунди на один запит).",
                solution: "Спроектовано реляційну схему PostgreSQL із рекурсивними CTE, композитними B-Tree індексами та автоматичними тригерами.",
                code: "WITH RECURSIVE NetworkTree AS (\n    SELECT id, parent_id, pressure FROM nodes WHERE parent_id IS NULL\n    UNION ALL\n    SELECT n.id, n.parent_id, n.pressure FROM nodes n\n    INNER JOIN NetworkTree nt ON n.parent_id = nt.id\n)\nSELECT * FROM NetworkTree;",
                metrics: "Час виконання запиту: з 4500 ms до 18 ms"
            },
            {
                tag: "ARTIFACT #VI • REALTIME CRM & ANALYTICS",
                title: "Inquisition Grimoire CRM",
                challenge: "Відсутність прозорої системи лояльності клієнтів та ручне адміністрування порушників без фіксації термінів блокування.",
                solution: "Автоматичний розрахунок титулів через патерн Strategy, канонізація спонсорів при 5+ закритих проєктах та система тимчасових банів з авто-зняттям.",
                code: "if (client.CompletedOrdersCount >= 5)\n{\n    client.IsHolySponsor = true;\n}\nclient.CustomTitle = _rankContext.CalculateTitle(client.CompletedOrdersCount, client.IsHolySponsor);",
                metrics: "Автоматизація CRM: 100% | Живий чат сповідей: Polling 4s"
            }
        ];

        function openInspectModal(idx) {
            const spec = portfolioSpecs[idx];
            document.getElementById('modalTag').textContent = spec.tag;
            document.getElementById('modalTitle').textContent = spec.title;
            document.getElementById('modalChallenge').textContent = spec.challenge;
            document.getElementById('modalSolution').textContent = spec.solution;
            document.getElementById('modalCode').textContent = spec.code;
            document.getElementById('modalMetrics').textContent = spec.metrics;
            document.getElementById('inspectBackdrop').classList.add('open');
        }

        function closeInspectModal() {
            document.getElementById('inspectBackdrop').classList.remove('open');
        }
    </script>
}