@{
    ViewData["Title"] = "Портфоліо";
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    .portfolio-sanctuary {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2.6rem;
        padding: 0.5rem 0;
    }

    .portfolio-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1.5rem;
        border-bottom: 1px solid rgba(201, 162, 94, 0.22);
        padding-bottom: 1.4rem;
    }

    .relic-crest-line {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.75rem;
        color: var(--accent-blue);
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

        .relic-crest-line::before {
            content: "";
            width: 24px;
            height: 1px;
            background: var(--primary-gold);
            box-shadow: 0 0 8px var(--primary-gold);
        }

    .filter-bar {
        display: flex;
        gap: 0.55rem;
        flex-wrap: wrap;
        background: rgba(9, 11, 18, 0.85);
        padding: 0.4rem;
        border-radius: 50px;
        border: 1px solid rgba(201, 162, 94, 0.25);
    }

    .filter-pill {
        background: transparent;
        border: 1px solid transparent;
        color: #9ca3af;
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.6px;
        padding: 0.42rem 1.15rem;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .filter-pill:hover {
            color: var(--gold-bright);
        }

        .filter-pill.active {
            background: linear-gradient(135deg, rgba(201, 162, 94, 0.26), rgba(56, 189, 248, 0.14));
            border-color: var(--primary-gold);
            color: #ffffff;
            box-shadow: 0 0 16px rgba(201, 162, 94, 0.22);
        }

    .relics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.7rem;
        perspective: 1200px;
    }

    .relic-card {
        position: relative;
        background: linear-gradient(180deg, rgba(15, 18, 29, 0.92) 0%, rgba(8, 10, 16, 0.96) 100%);
        border: 1px solid rgba(201, 162, 94, 0.28);
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.8), inset 0 0 25px rgba(0, 0, 0, 0.7);
    }

        .relic-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( 350px circle at var(--rx, 50%) var(--ry, 0%), rgba(201, 162, 94, 0.15), rgba(56, 189, 248, 0.05) 45%, transparent 70% );
            pointer-events: none;
            z-index: 0;
        }

        .relic-card:hover {
            border-color: var(--primary-gold);
            transform: translateY(-6px);
            box-shadow: 0 24px 55px rgba(0, 0, 0, 0.92), 0 0 28px rgba(201, 162, 94, 0.18);
        }

    .relic-blueprint-stage {
        position: relative;
        height: 155px;
        background: radial-gradient(circle at 50% 50%, rgba(22, 28, 45, 0.85), rgba(6, 8, 13, 0.98));
        border-bottom: 1px solid rgba(201, 162, 94, 0.22);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        z-index: 1;
    }

        .relic-blueprint-stage::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(201, 162, 94, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(201, 162, 94, 0.06) 1px, transparent 1px);
            background-size: 22px 22px;
            pointer-events: none;
        }

    .blueprint-svg {
        width: 100%;
        height: 130px;
        z-index: 2;
        filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.25));
        transition: transform 0.4s ease;
    }

    .relic-card:hover .blueprint-svg {
        transform: scale(1.06);
    }

    .relic-code-tag {
        position: absolute;
        top: 12px;
        left: 14px;
        font-family: 'Fira Code', monospace;
        font-size: 0.68rem;
        color: var(--gold-bright);
        background: rgba(6, 8, 13, 0.85);
        border: 1px solid rgba(201, 162, 94, 0.35);
        padding: 2px 9px;
        border-radius: 50px;
        z-index: 3;
    }

    .relic-Metric-badge {
        position: absolute;
        top: 12px;
        right: 14px;
        font-family: 'Fira Code', monospace;
        font-size: 0.68rem;
        color: #4ade80;
        background: rgba(6, 20, 14, 0.88);
        border: 1px solid rgba(74, 222, 128, 0.35);
        padding: 2px 9px;
        border-radius: 50px;
        z-index: 3;
    }

    .relic-body {
        padding: 1.4rem 1.5rem 1.2rem;
        position: relative;
        z-index: 1;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .relic-stack {
        font-family: 'Fira Code', monospace;
        color: var(--accent-blue);
        font-size: 0.74rem;
        margin-bottom: 0.45rem;
        letter-spacing: 0.4px;
    }

    .relic-title {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 0.55rem;
        line-height: 1.2;
    }

    .relic-desc {
        font-size: 0.84rem;
        color: #b4b4bb;
        line-height: 1.6;
        margin-bottom: 1.2rem;
        flex: 1;
    }

    .relic-stats-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        padding: 0.65rem 0;
        border-top: 1px solid rgba(201, 162, 94, 0.18);
        border-bottom: 1px solid rgba(201, 162, 94, 0.18);
        margin-bottom: 1.1rem;
    }

    .relic-stat-cell span {
        display: block;
        font-size: 0.68rem;
        color: #9ca3af;
        text-transform: uppercase;
    }

    .relic-stat-cell strong {
        font-family: 'Cinzel', serif;
        font-size: 0.92rem;
        color: var(--gold-bright);
    }

    .relic-actions {
        display: flex;
        gap: 0.6rem;
        align-items: center;
    }

    .exorcism-comparison-box {
        background: linear-gradient(180deg, rgba(13, 16, 26, 0.92) 0%, rgba(7, 9, 14, 0.96) 100%);
        border: 1px solid rgba(201, 162, 94, 0.35);
        border-radius: 18px;
        padding: 1.8rem 2rem;
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 2.5rem;
        align-items: center;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.85);
    }

    .audit-slider-wrap {
        margin-top: 1.2rem;
    }

    .audit-range {
        width: 100%;
        accent-color: var(--primary-gold);
        cursor: pointer;
        height: 6px;
    }

    .telemetry-comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .telemetry-box {
        background: rgba(6, 8, 13, 0.9);
        border: 1px solid rgba(201, 162, 94, 0.24);
        border-radius: 12px;
        padding: 1rem 1.1rem;
    }

    .inspect-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(3, 5, 9, 0.86);
        backdrop-filter: blur(10px);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

        .inspect-backdrop.open {
            display: flex;
            animation: fadeModal 0.25s ease;
        }

    .inspect-modal {
        max-width: 720px;
        width: 100%;
        background: radial-gradient(circle at top, rgba(201, 162, 94, 0.16), rgba(9, 11, 18, 0.98) 65%);
        border: 1px solid var(--primary-gold);
        border-radius: 20px;
        padding: 2.2rem;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.95), 0 0 35px rgba(201, 162, 94, 0.22);
        position: relative;
    }

    .inspect-code-block {
        background: #05070b;
        border: 1px solid rgba(56, 189, 248, 0.35);
        border-left: 3px solid var(--accent-blue);
        border-radius: 10px;
        padding: 1rem;
        font-family: 'Fira Code', monospace;
        font-size: 0.77rem;
        color: #93c5fd;
        overflow-x: auto;
        white-space: pre;
        margin: 1rem 0 1.4rem;
    }

    @@keyframes fadeModal {
        from {
            opacity: 0;
            transform: scale(0.96);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@media (max-width: 1080px) {
        .relics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .exorcism-comparison-box {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .relics-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="portfolio-sanctuary">
    <div class="portfolio-header">
        <div>
            <div class="relic-crest-line">Opus Magnum Ordo</div>
            <h1 class="gothic-title" style="margin-bottom: 0.2rem;">Портфоліо Ордену</h1>
            <div class="subtitle-gold" style="margin-bottom: 0;">Галерея завершених обрядів та освячених архітектур</div>
        </div>

        <div class="filter-bar">
            <button type="button" class="filter-pill active" onclick="filterRelics('all', this)">Усі діяння (6)</button>
            <button type="button" class="filter-pill" onclick="filterRelics('web', this)">Веб-Собори</button>
            <button type="button" class="filter-pill" onclick="filterRelics('backend', this)">Backend &amp; БД</button>
            <button type="button" class="filter-pill" onclick="filterRelics('design', this)">Сакральний UI/UX</button>
        </div>
    </div>

    <div class="relics-grid" id="relicsGrid">

        <article class="relic-card" data-category="web design">
            <div class="relic-blueprint-stage">
                <span class="relic-code-tag">ARTIFACT #I</span>
                <span class="relic-Metric-badge">99.9% UPTIME</span>
                <svg class="blueprint-svg" viewBox="0 0 260 120" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="130,12 195,104 65,104" fill="rgba(201,162,94,0.08)" stroke="#c9a25e" stroke-width="1.8" />
                    <circle cx="130" cy="64" r="24" fill="none" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="4 3" />
                    <circle cx="130" cy="64" r="9" fill="#38bdf8" opacity="0.8" />
                    <line x1="25" y1="64" x2="235" y2="64" stroke="rgba(201,162,94,0.35)" stroke-width="1" stroke-dasharray="3 3" />
                </svg>
            </div>
            <div class="relic-body">
                <div class="relic-stack">.NET 8 MVC • PostgreSQL • Custom SVG</div>
                <h3 class="relic-title">Sanctuary Corporate Portal</h3>
                <p class="relic-desc">
                    Флагманський портал ІТ-ордену у неоготичному стилі з інтерактивним 3D-артефактом, системою рангів та живою кімнатою сповіді.
                </p>
                <div class="relic-stats-row">
                    <div class="relic-stat-cell"><span>Архітектура</span><strong>DDD + UnitOfWork</strong></div>
                    <div class="relic-stat-cell"><span>Відгук ядра</span><strong>18 ms</strong></div>
                </div>
                <div class="relic-actions">
                    <button type="button" class="btn-blue btn-sm" style="flex: 1;" onclick="openInspectModal(0)">Дослідити архітектуру</button>
                    @if (!isAdmin)
                    {
                        <a asp-controller="Orders" asp-action="Create" class="btn-ritual btn-sm">Замовити →</a>
                    }
                </div>
            </div>
        </article>

        <article class="relic-card" data-category="web backend">
            <div class="relic-blueprint-stage">
                <span class="relic-code-tag">ARTIFACT #II</span>
                <span class="relic-Metric-badge">0 LOST TX</span>
                <svg class="blueprint-svg" viewBox="0 0 260 120" xmlns="http://www.w3.org/2000/svg">
                    <rect x="35" y="32" width="50" height="56" rx="6" fill="none" stroke="#c9a25e" stroke-width="1.8" />
                    <rect x="105" y="22" width="50" height="76" rx="6" fill="rgba(56,189,248,0.08)" stroke="#38bdf8" stroke-width="1.8" />
                    <rect x="175" y="32" width="50" height="56" rx="6" fill="none" stroke="#c9a25e" stroke-width="1.8" />
                    <line x1="85" y1="60" x2="105" y2="60" stroke="#f3d088" stroke-width="2" />
                    <line x1="155" y1="60" x2="175" y2="60" stroke="#f3d088" stroke-width="2" />
