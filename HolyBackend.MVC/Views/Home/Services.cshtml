@{
    ViewData["Title"] = "Послуги";
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    .services-sanctuary {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 3rem;
        padding: 0.5rem 0;
    }

    .services-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1.5rem;
        border-bottom: 1px solid rgba(201, 162, 94, 0.22);
        padding-bottom: 1.4rem;
    }

    .ritual-tag-line {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.76rem;
        color: var(--accent-blue);
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

        .ritual-tag-line::before {
            content: "";
            width: 24px;
            height: 1px;
            background: var(--primary-gold);
            box-shadow: 0 0 8px var(--primary-gold);
        }

    .rituals-split {
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        gap: 2.5rem;
        align-items: stretch;
    }

    .rituals-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .ritual-item-card {
        position: relative;
        background: rgba(11, 14, 22, 0.82);
        border: 1px solid rgba(201, 162, 94, 0.24);
        border-radius: 14px;
        padding: 1.25rem 1.4rem;
        display: grid;
        grid-template-columns: 54px 1fr auto;
        gap: 1.1rem;
        align-items: center;
        cursor: pointer;
        transition: all 0.28s ease;
        overflow: hidden;
    }

        .ritual-item-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: transparent;
            transition: background 0.28s ease, box-shadow 0.28s ease;
        }

        .ritual-item-card:hover {
            border-color: rgba(201, 162, 94, 0.55);
            transform: translateX(4px);
            background: rgba(16, 20, 32, 0.92);
        }

        .ritual-item-card.active {
            border-color: var(--primary-gold);
            background: linear-gradient(90deg, rgba(201, 162, 94, 0.16) 0%, rgba(12, 15, 24, 0.95) 100%);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.75), 0 0 25px rgba(201, 162, 94, 0.14);
            transform: translateX(6px);
        }

            .ritual-item-card.active::before {
                background: var(--accent-blue);
                box-shadow: 0 0 12px var(--accent-blue);
            }

    .ritual-icon-box {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        background: rgba(7, 9, 14, 0.9);
        border: 1px solid rgba(201, 162, 94, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color 0.25s, box-shadow 0.25s;
    }

    .ritual-item-card.active .ritual-icon-box {
        border-color: var(--accent-blue);
        box-shadow: 0 0 18px rgba(56, 189, 248, 0.25);
    }

    .ritual-icon-svg {
        width: 30px;
        height: 30px;
    }

    .ritual-item-title {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 1.24rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.2rem;
        letter-spacing: 0.5px;
    }

    .ritual-item-card.active .ritual-item-title {
        color: var(--gold-bright);
    }

    .ritual-item-short {
        font-size: 0.83rem;
        color: #a1a1aa;
        line-height: 1.45;
    }

    .ritual-enum-badge {
        font-family: 'Fira Code', monospace;
        font-size: 0.7rem;
        padding: 4px 10px;
        border-radius: 50px;
        background: rgba(56, 189, 248, 0.08);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: var(--accent-blue);
        white-space: nowrap;
    }

    .altar-inspector-card {
        background: radial-gradient(circle at 50% 22%, rgba(201, 162, 94, 0.16), rgba(9, 11, 18, 0.96) 72%);
        border: 1px solid rgba(201, 162, 94, 0.42);
        border-radius: 20px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.9), inset 0 0 30px rgba(0, 0, 0, 0.8);
        overflow: hidden;
    }

    .inspector-seal-wrap {
        position: relative;
        width: 170px;
        height: 170px;
        margin: 0 auto 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .seal-outer-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1px dashed rgba(201, 162, 94, 0.5);
        box-shadow: 0 0 35px rgba(56, 189, 248, 0.18), inset 0 0 25px rgba(201, 162, 94, 0.18);
        animation: spinRingCW 38s linear infinite;
    }

    .seal-inner-ring {
        position: absolute;
        inset: 14px;
        border-radius: 50%;
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-top: 2px solid var(--primary-gold);
        border-bottom: 2px solid var(--accent-blue);
        animation: spinRingCCW 24s linear infinite;
    }

    .seal-core-glyph {
        font-family: 'Fira Code', monospace;
        font-size: 2.1rem;
        font-weight: 700;
        color: var(--accent-blue);
        text-shadow: 0 0 18px var(--blue-glow);
        z-index: 2;
        transition: transform 0.3s ease;
    }

    .inspector-title {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 1.65rem;
        color: var(--gold-bright);
        text-align: center;
        margin-bottom: 0.4rem;
    }

    .inspector-subtitle {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-style: italic;
        font-size: 1.12rem;
        color: #d4d4d8;
        text-align: center;
        margin-bottom: 1.2rem;
    }

    .deliverables-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.65rem;
        margin-bottom: 1.2rem;
    }

    .deliverable-pill {
        background: rgba(6, 8, 13, 0.85);
        border: 1px solid rgba(201, 162, 94, 0.22);
        border-radius: 8px;
        padding: 0.55rem 0.75rem;
        font-size: 0.78rem;
        color: #e4e4e7;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .deliverable-dot {
        width: 6px;
        height: 6px;
        transform: rotate(45deg);
        background: var(--primary-gold);
        box-shadow: 0 0 6px var(--primary-gold);
        flex-shrink: 0;
    }

    .ritual-code-preview {
        background: #05070b;
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-left: 3px solid var(--accent-blue);
        border-radius: 10px;
        padding: 0.85rem 1rem;
        font-family: 'Fira Code', monospace;
        font-size: 0.75rem;
        color: #93c5fd;
        margin-bottom: 1.3rem;
        overflow-x: auto;
        white-space: pre;
        line-height: 1.5;
    }

    .oracle-calculator {
        background: linear-gradient(180deg, rgba(13, 16, 26, 0.9) 0%, rgba(8, 10, 16, 0.95) 100%);
        border: 1px solid rgba(201, 162, 94, 0.32);
        border-radius: 18px;
        padding: 1.8rem 2rem;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 2.5rem;
        align-items: center;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
    }

    .oracle-controls {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .oracle-row {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .oracle-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.82rem;
        color: var(--gold-bright);
        font-family: 'Cinzel', serif;
    }

    .oracle-options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
    }

    .oracle-opt-btn {
        background: rgba(7, 9, 14, 0.9);
        border: 1px solid rgba(201, 162, 94, 0.25);
        color: #9ca3af;
        padding: 0.5rem 0.6rem;
        border-radius: 8px;
        font-family: 'Fira Code', monospace;
        font-size: 0.76rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .oracle-opt-btn:hover {
            border-color: var(--primary-gold);
            color: #fff;
        }

        .oracle-opt-btn.selected {
            background: rgba(201, 162, 94, 0.22);
            border-color: var(--primary-gold);
            color: var(--gold-bright);
            box-shadow: 0 0 12px rgba(201, 162, 94, 0.2);
        }

    .oracle-result-box {
        background: rgba(6, 8, 13, 0.92);
        border: 1px dashed rgba(56, 189, 248, 0.45);
        border-radius: 14px;
        padding: 1.4rem;
        text-align: center;
    }

    @@keyframes spinRingCW {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes spinRingCCW {
        from {
            transform: rotate(360deg);
        }

        to {
            transform: rotate(0deg);
        }
    }

    @@media (max-width: 1024px) {
        .rituals-split, .oracle-calculator {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="services-sanctuary">
    <div class="services-header">
        <div>
            <div class="ritual-tag-line">Liturgia Technologica</div>
            <h1 class="gothic-title" style="margin-bottom: 0.2rem;">Послуги Ордену</h1>
            <div class="subtitle-gold" style="margin-bottom: 0;">Ритуали цифрового спасіння будь-якої складності</div>
        </div>
        <p style="max-width: 460px; font-size: 0.88rem; color: #a1a1aa; line-height: 1.6;">
            Оберіть потрібне таїнство зі списку нижче, щоб оглянути архітектурну печатку, складові обряду та канони його виконання.
        </p>
    </div>

    <div class="rituals-split">

        <div class="rituals-list">

            <div class="ritual-item-card active" onclick="selectRitual(0, this)">
                <div class="ritual-icon-box">
                    <svg class="ritual-icon-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="20,3 36,14 36,36 4,36 4,14" fill="none" stroke="#c9a25e" stroke-width="2" />
                        <line x1="20" y1="3" x2="20" y2="36" stroke="#38bdf8" stroke-width="1.5" />
                        <circle cx="20" cy="18" r="5" fill="none" stroke="#f3d088" stroke-width="1.8" />
                    </svg>
                </div>
                <div>
                    <div class="ritual-item-title">Зведення Веб-Собору під ключ</div>
                    <div class="ritual-item-short">Комплексна розробка веб-сайтів та корпоративних систем на .NET 8 MVC з нуля до деплою.</div>
                </div>
                <span class="ritual-enum-badge">Standard</span>
            </div>

            <div class="ritual-item-card" onclick="selectRitual(1, this)">
                <div class="ritual-icon-box">
                    <svg class="ritual-icon-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                        <ellipse cx="20" cy="10" rx="14" ry="5" fill="none" stroke="#38bdf8" stroke-width="2" />
                        <path d="M 6 10 L 6 20 C 6 23 34 23 34 20 L 34 10" fill="none" stroke="#c9a25e" stroke-width="2" />
                        <path d="M 6 20 L 6 30 C 6 33 34 33 34 30 L 34 20" fill="none" stroke="#c9a25e" stroke-width="2" />
                    </svg>
                </div>
                <div>
                    <div class="ritual-item-title">Архітектура Ядра та Сховищ Даних</div>
                    <div class="ritual-item-short">Проєктування Clean Architecture, REST API, реляційних схем PostgreSQL (Supabase) та патернів DDD.</div>
                </div>
                <span class="ritual-enum-badge">Backend</span>
            </div>

            <div class="ritual-item-card" onclick="selectRitual(2, this)">
                <div class="ritual-icon-box">
                    <svg class="ritual-icon-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="20" cy="20" r="15" fill="none" stroke="#c9a25e" stroke-width="2" />
                        <polygon points="20,7 33,20 20,33 7,20" fill="none" stroke="#38bdf8" stroke-width="1.6" />
                        <circle cx="20" cy="20" r="3.5" fill="#f3d088" />
                    </svg>
                </div>
                <div>
                    <div class="ritual-item-title">Естетична Інквізиція та UI/UX Дизайн</div>
                    <div class="ritual-item-short">Авторські дизайн-системи, інтерактивна SVG-графіка, 3D-мікровзаємодії та адаптивна верстка.</div>
                </div>
                <span class="ritual-enum-badge">Design</span>
            </div>

            <div class="ritual-item-card" onclick="selectRitual(3, this)">
                <div class="ritual-icon-box">
                    <svg class="ritual-icon-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                        <line x1="20" y1="4" x2="20" y2="36" stroke="#f3d088" stroke-width="2.4" />
                        <path d="M 10 14 L 20 18 L 30 14" fill="none" stroke="#c9a25e" stroke-width="2" />
                        <polygon points="20,8 28,22 20,32 12,22" fill="none" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 2" />
                    </svg>
                </div>
                <div>
                    <div class="ritual-item-title">Екзорцизм Легасі-Коду та Рефакторинг</div>
                    <div class="ritual-item-short">Вигнання критичних багів, оптимізація повільних SQL-запитів, лікування Deadlock-ів та прискорення систем.</div>
                </div>
                <span class="ritual-enum-badge">Refactoring</span>
            </div>

        </div>

        <div class="altar-inspector-card">
            <div>
                <div class="inspector-seal-wrap">
                    <div class="seal-outer-ring"></div>
                    <div class="seal-inner-ring"></div>
                    <div class="seal-core-glyph" id="inspectorGlyph">&lt;/&gt;</div>
                </div>

                <h2 class="inspector-title" id="inspectorTitle">Зведення Веб-Собору під ключ</h2>
                <div class="inspector-subtitle" id="inspectorSubtitle">Канонічний цикл створення веб-платформи</div>

                <div class="deliverables-grid" id="inspectorDeliverables">
                    <div class="deliverable-pill"><span class="deliverable-dot"></span><span>ASP.NET Core 8 MVC</span></div>
                    <div class="deliverable-pill"><span class="deliverable-dot"></span><span>Авторизація та Ролі</span></div>
                    <div class="deliverable-pill"><span class="deliverable-dot"></span><span>Особистий Кабінет</span></div>
                    <div class="deliverable-pill"><span class="deliverable-dot"></span><span>Деплой та SSL-захист</span></div>
                </div>

                <div class="ritual-code-preview" id="inspectorCode">
                    // Освячення архітектури перед деплоєм
                    var order = _orderFactory.CreateOrder(title, desc, OrderType.Standard, clientId);
                    await _orderValidator.ValidateAndThrowAsync(order);
                    await _unitOfWork.CommitTransactionAsync();
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-top: 1px solid rgba(201,162,94,0.22); padding-top: 1.1rem;">
                <div>
                    <div style="font-size: 0.72rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 1px;">Термін виконання</div>
                    <div style="font-family: 'Cinzel', serif; color: var(--gold-bright); font-size: 1.05rem; font-weight: 700;" id="inspectorDuration">Від 7 до 21 дня</div>
                </div>

                @if (!isAdmin)
                {
                    <a id="inspectorOrderLink" asp-controller="Orders" asp-action="Create" class="btn-ritual" style="padding: 0.75rem 1.7rem;">
                        Замовити цей обряд ✦
                    </a>
                }
                else
                {
                    <a asp-controller="Orders" asp-action="Cabinet" class="btn-blue" style="padding: 0.75rem 1.5rem;">
                        Перейти в Кабінет →
                    </a>
                }
            </div>
        </div>

    </div>

    <div class="oracle-calculator">
        <div>
            <div class="ritual-tag-line" style="margin-bottom: 0.3rem;">Calculatio Sacra</div>
            <h3 style="font-family: 'Cormorant Unicase', 'Cinzel', serif; font-size: 1.6rem; color: var(--gold-bright); margin-bottom: 0.4rem;">
                Оракул Складності Ритуалу
            </h3>
            <p style="font-size: 0.84rem; color: #a1a1aa; margin-bottom: 1.2rem;">
                Вкажіть параметри вашого майбутнього проєкту, щоб миттєво розрахувати необхідний ранг архітектури та орієнтовну тривалість робіт.
            </p>

            <div class="oracle-controls">
                <div class="oracle-row">
                    <div class="oracle-label"><span>I. Масштаб системи</span><span id="lblScale">Середній Храм</span></div>
                    <div class="oracle-options" data-group="scale">
                        <button type="button" class="oracle-opt-btn" onclick="setOracle('scale', 1, 'Каплиця (Landing / MVP)', this)">Малий (MVP)</button>
                        <button type="button" class="oracle-opt-btn selected" onclick="setOracle('scale', 2, 'Середній Храм (Web App)', this)">Веб-платформа</button>
                        <button type="button" class="oracle-opt-btn" onclick="setOracle('scale', 3, 'Величний Собор (Enterprise)', this)">Enterprise</button>
                    </div>
                </div>

                <div class="oracle-row">
                    <div class="oracle-label"><span>II. Складність бази даних та логіки</span><span id="lblDb">Реляційна PostgreSQL</span></div>
                    <div class="oracle-options" data-group="db">
                        <button type="button" class="oracle-opt-btn" onclick="setOracle('db', 1, 'Базова схема', this)">Базова</button>
                        <button type="button" class="oracle-opt-btn selected" onclick="setOracle('db', 2, 'Реляційна PostgreSQL + CRM', this)">PostgreSQL + CRM</button>
                        <button type="button" class="oracle-opt-btn" onclick="setOracle('db', 3, 'Високонавантажений кластер', this)">Highload Кластер</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="oracle-result-box">
            <div style="font-family: 'Fira Code', monospace; font-size: 0.72rem; color: var(--accent-blue); letter-spacing: 2px; margin-bottom: 0.4rem;">
                ПРОРОЦТВО ОРАКУЛА
            </div>
            <div id="oracleVerdictTitle" style="font-family: 'Cormorant Unicase', 'Cinzel', serif; font-size: 1.4rem; color: #ffffff; font-weight: 700; margin-bottom: 0.8rem;">
                Орденська Веб-Платформа (.NET 8 + Supabase)
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 0.9rem 0; margin-bottom: 1.1rem;">
                <div>
                    <div style="font-size: 0.72rem; color: #9ca3af;">Орієнтовний час</div>
                    <div id="oracleDays" style="font-family: 'Cinzel', serif; font-size: 1.25rem; color: var(--gold-bright); font-weight: 700;">10 – 14 днів</div>
                </div>
                <div>
                    <div style="font-size: 0.72rem; color: #9ca3af;">Архітектурний канон</div>
                    <div id="oraclePattern" style="font-family: 'Fira Code', monospace; font-size: 0.85rem; color: #4ade80; margin-top: 4px;">DDD + UnitOfWork</div>
                </div>
            </div>

            @if (!isAdmin)
            {
                <a asp-controller="Orders" asp-action="Create" class="btn-ritual" style="width: 100%;">
                    Передати ці параметри у Сповідь →
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ritualsData = [
            {
                glyph: "</>",
                title: "Зведення Веб-Собору під ключ",
                subtitle: "Канонічний цикл створення веб-платформи від фундаменту до релізу",
                duration: "Від 7 до 21 дня",
                deliverables: [
                    "ASP.NET Core 8 MVC",
                    "Авторизація та Ролі",
                    "Особистий Кабінет",
                    "Деплой та SSL-захист"
                ],
                code: "// Освячення архітектури перед деплоєм\nvar order = _orderFactory.CreateOrder(title, desc, OrderType.Standard, clientId);\nawait _orderValidator.ValidateAndThrowAsync(order);\nawait _unitOfWork.CommitTransactionAsync();"
            },
            {
                glyph: "{DB}",
                title: "Архітектура Ядра та Сховищ Даних",
                subtitle: "Непорушний серверний фундамент, транзакції та чиста бізнес-логіка",
                duration: "Від 5 до 14 днів",
                deliverables: [
                    "PostgreSQL / Supabase",
                    "EF Core Міграції",
                    "Патерни Strategy & Observer",
                    "FluentValidation Ядра"
                ],
                code: "// Пул захищених з'єднань із Храмом Даних\noptions.UseNpgsql(connectionString, npgsql => \n    npgsql.EnableRetryOnFailure(maxRetryCount: 5));\nawait _unitOfWork.Orders.AddAsync(entity);"
            },
            {
                glyph: "✦ UI",
                title: "Естетична Інквізиція та UI/UX Дизайн",
                subtitle: "Візуальна довершеність, що перетворює темряву екрана на шедевр",
                duration: "Від 4 до 10 днів",
                deliverables: [
                    "Авторські макети Figma",
                    "Інтерактивна SVG-графіка",
                    "3D-паралакс ефекти",
                    "Адаптивна верстка"
                ],
                code: "/* Золотий перетин та сакральне світіння */\n.sanctuary-card {\n    backdrop-filter: blur(16px);\n    border: 1px solid var(--primary-gold);\n    box-shadow: 0 0 35px var(--gold-glow);\n}"
            },
            {
                glyph: "⚔ FIX",
                title: "Екзорцизм Легасі-Коду та Рефакторинг",
                subtitle: "Термінове вигнання багів, очищення архітектури та прискорення БД",
                duration: "Від 1 до 5 днів",
                deliverables: [
                    "Усунення Exception-ів",
                    "Оптимізація SQL-індексів",
                    "Покриття валідаторами",
                    "Ліквідація техборгу"
                ],
                code: "// Вигнання легасі-демонів із критичного модуля\nif (legacyCode.HasBugs)\n{\n    await _exorcistService.RefactorToCleanArchitectureAsync(module);\n}"
            }
        ];

        function selectRitual(index, cardEl) {
            document.querySelectorAll('.ritual-item-card').forEach(c => c.classList.remove('active'));
            cardEl.classList.add('active');

            const item = ritualsData[index];
            const glyphEl = document.getElementById('inspectorGlyph');
            glyphEl.style.transform = 'scale(0.8)';
            setTimeout(() => {
                glyphEl.textContent = item.glyph;
                glyphEl.style.transform = 'scale(1)';
            }, 120);

            document.getElementById('inspectorTitle').textContent = item.title;
            document.getElementById('inspectorSubtitle').textContent = item.subtitle;
            document.getElementById('inspectorDuration').textContent = item.duration;
            document.getElementById('inspectorCode').textContent = item.code;

            const delivContainer = document.getElementById('inspectorDeliverables');
            delivContainer.innerHTML = item.deliverables.map(d =>
                `<div class="deliverable-pill"><span class="deliverable-dot"></span><span>${d}</span></div>`
            ).join('');
        }

        let oracleState = { scale: 2, db: 2 };

        function setOracle(group, val, labelText, btn) {
            oracleState[group] = val;
            const groupWrap = btn.parentElement;
            groupWrap.querySelectorAll('.oracle-opt-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');

            if (group === 'scale') document.getElementById('lblScale').textContent = labelText;
            if (group === 'db') document.getElementById('lblDb').textContent = labelText;

            const score = oracleState.scale + oracleState.db;
            const titleEl = document.getElementById('oracleVerdictTitle');
            const daysEl = document.getElementById('oracleDays');
            const patternEl = document.getElementById('oraclePattern');

            if (score <= 2) {
                titleEl.textContent = "Мала Каплиця (Швидкий MVP Старт)";
                daysEl.textContent = "3 – 6 днів";
                patternEl.textContent = "MVC + Factory";
            } else if (score <= 4) {
                titleEl.textContent = "Орденська Веб-Платформа (.NET 8 + Supabase)";
                daysEl.textContent = "10 – 14 днів";
                patternEl.textContent = "DDD + UnitOfWork";
            } else {
                titleEl.textContent = "Кафедральний Enterprise-Собор Високої Надійності";
                daysEl.textContent = "21 – 35 днів";
                patternEl.textContent = "Clean Arch + CQRS";
            }
        }
    </script>
}