@{
    ViewData["Title"] = "Головна";
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    .hero-split {
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        gap: 3.5rem;
        align-items: center;
        width: 100%;
        min-height: 78vh;
        padding: 1rem 0;
    }

    .sql-terminal-line {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.82rem;
        color: #94a3b8;
        margin-bottom: 1rem;
        letter-spacing: 0.5px;
    }

        .sql-terminal-line .sql-keyword {
            color: var(--accent-blue);
            font-weight: 600;
            text-shadow: 0 0 10px var(--blue-glow);
        }

        .sql-terminal-line .sql-bool {
            color: var(--gold-bright);
        }

    .pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent-blue);
        box-shadow: 0 0 10px var(--accent-blue);
        animation: pulseGlow 2s infinite;
    }

    .hero-main-title {
        font-family: 'UnifrakturMaguntia', serif;
        font-size: 6.2rem;
        font-weight: normal;
        color: #f7dfa5;
        text-shadow: 0 0 18px rgba(243, 208, 136, 0.5), 0 0 40px rgba(201, 162, 94, 0.35), 0 8px 24px rgba(0, 0, 0, 0.95);
        line-height: 0.98;
        margin-bottom: 1.5rem;
        letter-spacing: 2px;
    }

    .hero-description {
        font-family: 'Cormorant Garamond', Georgia, serif;
        color: #d4d4d8;
        font-size: 1.32rem;
        font-weight: 500;
        max-width: 540px;
        line-height: 1.55;
        letter-spacing: 0.3px;
    }

        .hero-description strong {
            color: #ffffff;
            font-weight: 700;
        }

        .hero-description .tech-highlight {
            font-family: 'Cinzel', serif;
            color: var(--accent-blue);
            font-size: 1.15rem;
            font-weight: 700;
            text-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
        }

    .sacred-quote-block {
        margin: 2.2rem 0;
        max-width: 500px;
        text-align: center;
        position: relative;
    }

    .ornament-line-top {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-bottom: 0.9rem;
    }

        .ornament-line-top::before,
        .ornament-line-top::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(201, 162, 94, 0.65), transparent);
        }

    .ornament-star {
        color: var(--accent-blue);
        font-size: 0.95rem;
        text-shadow: 0 0 12px var(--accent-blue), 0 0 20px var(--primary-gold);
    }

    .sacred-quote-text {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-style: italic;
        font-size: 1.3rem;
        color: var(--gold-bright);
        line-height: 1.45;
        padding: 0 1rem;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
    }

    .ornament-line-bottom {
        height: 1px;
        width: 85%;
        margin: 0.9rem auto 0;
        background: linear-gradient(90deg, transparent, rgba(201, 162, 94, 0.45), transparent);
    }

    .hero-cta-group {
        display: flex;
        gap: 1.2rem;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .btn-exorcism-prime {
        position: relative;
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-weight: 700;
        font-size: 1.12rem;
        letter-spacing: 1px;
        color: #f7dfa5;
        padding: 0.95rem 2.4rem;
        border-radius: 50px;
        text-decoration: none;
        background: radial-gradient(circle at center, rgba(201, 162, 94, 0.28) 0%, rgba(15, 14, 18, 0.92) 100%);
        border: 1.5px solid var(--primary-gold);
        box-shadow: 0 0 25px rgba(201, 162, 94, 0.28), inset 0 0 15px rgba(201, 162, 94, 0.2);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-exorcism-prime:hover {
            background: linear-gradient(135deg, #dfba73, #b5893e);
            color: #06070a;
            box-shadow: 0 0 40px rgba(243, 208, 136, 0.65);
            transform: translateY(-2px);
        }

    .hero-metrics {
        display: flex;
        gap: 2.5rem;
        margin-top: 2.6rem;
        padding-top: 1.4rem;
        border-top: 1px solid rgba(201, 162, 94, 0.18);
        max-width: 500px;
    }

    .metric-item strong {
        display: block;
        font-family: 'Cinzel', serif;
        font-size: 1.3rem;
        color: var(--gold-bright);
        text-shadow: 0 0 12px rgba(201, 162, 94, 0.3);
    }

    .metric-item span {
        font-family: 'Cormorant Garamond', serif;
        font-size: 0.98rem;
        color: #a1a1aa;
    }

    .altar-scene {
        perspective: 1400px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        user-select: none;
    }

    .divine-artifact {
        position: relative;
        width: 500px;
        height: 520px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transform-style: preserve-3d;
        transition: transform 0.08s ease-out;
    }

    .divine-aura {
        position: absolute;
        width: 440px;
        height: 440px;
        border-radius: 50%;
        background: radial-gradient( circle, rgba(201, 162, 94, 0.25) 0%, rgba(56, 189, 248, 0.14) 40%, transparent 70% );
        filter: blur(22px);
        transform: translateZ(-45px);
        pointer-events: none;
        animation: breatheAura 5s ease-in-out infinite alternate;
    }

    .scan-shockwave {
        position: absolute;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 2px solid var(--accent-blue);
        box-shadow: 0 0 30px var(--accent-blue), inset 0 0 20px var(--primary-gold);
        opacity: 0;
        pointer-events: none;
        transform: translateZ(30px) scale(0.5);
    }

    .pulse-wave .scan-shockwave {
        animation: shockwaveAnim 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .divine-eye-svg {
        width: 460px;
        height: 360px;
        overflow: visible;
        transform: translateZ(55px);
        filter: drop-shadow(0 22px 35px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 28px rgba(201, 162, 94, 0.4));
        cursor: pointer;
    }

    .spin-slow-cw {
        transform-origin: 200px 145px;
        animation: svgSpinCW 60s linear infinite;
    }

    .spin-slow-ccw {
        transform-origin: 200px 145px;
        animation: svgSpinCCW 40s linear infinite;
    }

    #eyelidBlinkGroup {
        transition: transform 0.14s cubic-bezier(0.4, 0, 0.2, 1);
        transform-origin: 200px 145px;
    }

    .blink #eyelidBlinkGroup {
        transform: scaleY(0.03);
    }

    .floating-telemetry {
        margin-top: 0.4rem;
        transform: translateZ(40px);
        text-align: center;
        pointer-events: none;
    }

    .telemetry-code {
        font-family: 'Fira Code', monospace;
        font-size: 0.74rem;
        color: var(--accent-blue);
        letter-spacing: 2px;
        text-shadow: 0 0 10px var(--blue-glow);
    }

    .telemetry-sub {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 0.85rem;
        color: var(--gold-bright);
        letter-spacing: 2.5px;
        margin-top: 4px;
        opacity: 0.85;
    }

    @@keyframes svgSpinCW {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes svgSpinCCW {
        from {
            transform: rotate(360deg);
        }

        to {
            transform: rotate(0deg);
        }
    }

    @@keyframes shockwaveAnim {
        0% {
            opacity: 0.95;
            transform: translateZ(30px) scale(0.4);
        }

        100% {
            opacity: 0;
            transform: translateZ(30px) scale(3.4);
        }
    }

    @@keyframes breatheAura {
        0% {
            transform: translateZ(-45px) scale(0.92);
            opacity: 0.75;
        }

        100% {
            transform: translateZ(-45px) scale(1.08);
            opacity: 1;
        }
    }

    @@keyframes pulseGlow {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.4;
            transform: scale(0.8);
        }
    }

    @@keyframes floatBinary {
        0% {
            transform: translateY(8px);
            opacity: 0.25;
        }

        50% {
            opacity: 0.85;
        }

        100% {
            transform: translateY(-10px);
            opacity: 0.2;
        }
    }

    .binary-float-1 {
        animation: floatBinary 3.2s infinite ease-in-out;
    }

    .binary-float-2 {
        animation: floatBinary 4.1s infinite ease-in-out 1.2s;
    }

    @@media (max-width: 992px) {
        .hero-split {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .hero-description, .sacred-quote-block, .hero-metrics, .hero-cta-group {
            margin-left: auto;
            margin-right: auto;
            justify-content: center;
        }

        .hero-main-title {
            font-size: 4.5rem;
        }

        .divine-artifact {
            width: 360px;
            height: 390px;
        }

        .divine-eye-svg {
            width: 350px;
            height: 270px;
        }
    }
</style>

<div class="hero-split">
    <div>
        <div class="sql-terminal-line">
            <span class="pulse-dot"></span>
            <span><span class="sql-keyword">SELECT</span> * <span class="sql-keyword">FROM</span> miracles <span class="sql-keyword">WHERE</span> bug = <span class="sql-bool">false</span>;</span>
        </div>

        <h1 class="hero-main-title">Pray &amp; Deploy</h1>

        <p class="hero-description" data-i18n="hero.desc">
            Ми, <strong>Орден Багоугодних</strong>, створюємо сайти та складні веб-додатки на замовлення, використовуючи міць технологій <span class="tech-highlight">.NET</span>, <strong>Clean Architecture</strong> та <strong>PostgreSQL</strong>.
        </p>

        <div class="sacred-quote-block">
            <div class="ornament-line-top">
                <span class="ornament-star">✦</span>
            </div>
            <div class="sacred-quote-text" data-i18n="hero.quote">
                «Наш код чистий, як сповідь,<br />
                а архітектура надійна, як фундамент собору.»
            </div>
            <div class="ornament-line-bottom"></div>
        </div>

        <div class="hero-cta-group">
            @if (!isAdmin)
            {
                <a asp-controller="Orders" asp-action="Create" class="btn-exorcism-prime" data-i18n="hero.cta">
                    <span>Замовити екзорцизм коду</span>
                    <span style="color: var(--accent-blue);">✦</span>
                </a>
            }
            else
            {
                <a asp-controller="Orders" asp-action="Cabinet" class="btn-exorcism-prime">
                    <span>Відкрити Архів Сповідей</span>
                </a>
            }

            <a asp-controller="Home" asp-action="Services" class="btn-blue" style="padding: 0.9rem 1.8rem; font-size: 1.05rem;">
                Ритуали Ордену →
            </a>
        </div>

        <div class="hero-metrics">
            <div class="metric-item">
                <strong>99.9%</strong>
                <span>Безгрішний Uptime</span>
            </div>
            <div class="metric-item">
                <strong>.NET 8</strong>
                <span>Чиста Архітектура</span>
            </div>
            <div class="metric-item">
                <strong>Supabase</strong>
                <span>PostgreSQL Храм</span>
            </div>
        </div>
    </div>

    <div class="altar-scene">
        <div class="divine-artifact" id="artifactContainer">
            <div class="divine-aura"></div>
            <div class="scan-shockwave"></div>

            <svg class="divine-eye-svg" id="eyeSvg" viewBox="0 0 400 310" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="goldMetal" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#fff6d6" />
                        <stop offset="35%" stop-color="#e5be73" />
                        <stop offset="70%" stop-color="#b3873b" />
                        <stop offset="100%" stop-color="#6e4f1d" />
                    </linearGradient>

                    <linearGradient id="neonBlueBeam" x1="0%" y1="100%" x2="0%" y2="0%">
                        <stop offset="0%" stop-color="rgba(56, 189, 248, 0)" />
                        <stop offset="50%" stop-color="rgba(56, 189, 248, 0.65)" />
                        <stop offset="100%" stop-color="#38bdf8" />
                    </linearGradient>

                    <radialGradient id="scleraDepth" cx="50%" cy="50%" r="55%">
                        <stop offset="0%" stop-color="#161d2e" />
                        <stop offset="65%" stop-color="#0a0d16" />
                        <stop offset="100%" stop-color="#020306" />
                    </radialGradient>

                    <radialGradient id="detailedIris" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#05070c" />
                        <stop offset="22%" stop-color="#f3d088" />
                        <stop offset="40%" stop-color="#38bdf8" />
                        <stop offset="70%" stop-color="#0284c7" />
                        <stop offset="88%" stop-color="#1e293b" />
                        <stop offset="100%" stop-color="#020617" />
                    </radialGradient>

                    <linearGradient id="eyelidShadow" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="rgba(0,0,0,0.88)" />
                        <stop offset="35%" stop-color="rgba(0,0,0,0)" />
                        <stop offset="75%" stop-color="rgba(0,0,0,0)" />
                        <stop offset="100%" stop-color="rgba(0,0,0,0.78)" />
                    </linearGradient>

                    <clipPath id="eyeSocketClip">
                        <path d="M 55 145 C 115 62, 285 62, 345 145 C 285 228, 115 228, 55 145 Z" />
                    </clipPath>
                </defs>

                <g class="spin-slow-cw" opacity="0.55">
                    <circle cx="200" cy="145" r="142" fill="none" stroke="url(#goldMetal)" stroke-width="1" stroke-dasharray="3 7" />
                    <circle cx="200" cy="145" r="134" fill="none" stroke="rgba(201,162,94,0.35)" stroke-width="4" stroke-dasharray="1 11" />
                </g>

                <g class="spin-slow-ccw" opacity="0.45">
                    <circle cx="200" cy="145" r="118" fill="none" stroke="#38bdf8" stroke-width="1" stroke-dasharray="18 8 4 8" />
                </g>

                <g id="gloryRays">
                    <ellipse cx="200" cy="-2" rx="46" ry="10" fill="none" stroke="url(#goldMetal)" stroke-width="2.5" opacity="0.9" />
                    <ellipse cx="200" cy="-2" rx="34" ry="6" fill="none" stroke="#38bdf8" stroke-width="1" opacity="0.6" />

                    <g stroke="url(#goldMetal)" opacity="0.5">
                        <line x1="200" y1="-22" x2="200" y2="295" stroke-width="1.8" stroke-dasharray="6 4" />
                        <line x1="35" y1="35" x2="365" y2="255" stroke-width="1.4" />
                        <line x1="35" y1="255" x2="365" y2="35" stroke-width="1.4" />
                        <line x1="10" y1="145" x2="390" y2="145" stroke-width="1.2" stroke-dasharray="4 6" />
                    </g>

                    <path d="M 164 38 Q 148 12 172 8" fill="none" stroke="#991b1b" stroke-width="4" stroke-linecap="round" opacity="0.75" />
                    <path d="M 236 38 Q 252 12 228 8" fill="none" stroke="#991b1b" stroke-width="4" stroke-linecap="round" opacity="0.75" />
                </g>

                <g opacity="0.85">
                    <line x1="200" y1="305" x2="200" y2="245" stroke="url(#neonBlueBeam)" stroke-width="3" />
                    <line x1="184" y1="298" x2="184" y2="252" stroke="url(#neonBlueBeam)" stroke-width="2" />
                    <line x1="216" y1="298" x2="216" y2="252" stroke="url(#neonBlueBeam)" stroke-width="2" />

                    <text x="28" y="115" fill="#c9a25e" font-family="Fira Code, monospace" font-size="16" font-weight="bold" class="binary-float-1" opacity="0.75">&lt;/&gt;</text>
                    <text x="342" y="108" fill="#38bdf8" font-family="Fira Code, monospace" font-size="13" font-weight="bold" class="binary-float-2" opacity="0.75">01</text>
                    <text x="352" y="124" fill="#e5e7eb" font-family="Fira Code, monospace" font-size="13" font-weight="bold" class="binary-float-1" opacity="0.65">10</text>
                </g>

                <g id="sacredTriangle">
                    <polygon points="200,12 368,252 32,252"
                             fill="rgba(8, 10, 16, 0.76)"
                             stroke="url(#goldMetal)"
                             stroke-width="3" />
                    <polygon points="200,26 350,242 50,242"
                             fill="none"
                             stroke="rgba(201, 162, 94, 0.45)"
                             stroke-width="1.2"
                             stroke-dasharray="8 4" />
                    <circle cx="200" cy="26" r="3.5" fill="#f3d088" />
                    <circle cx="350" cy="242" r="3.5" fill="#f3d088" />
                    <circle cx="50" cy="242" r="3.5" fill="#f3d088" />
                </g>

                <g id="eyelidBlinkGroup">
                    <path d="M 55 145 C 115 62, 285 62, 345 145 C 285 228, 115 228, 55 145 Z"
                          fill="url(#scleraDepth)" />

                    <g clip-path="url(#eyeSocketClip)">
                        <g stroke="rgba(201, 162, 94, 0.25)" stroke-width="1" fill="none">
                            <path d="M 58 145 Q 85 132 110 138 M 85 132 Q 98 122 115 125" />
                            <path d="M 62 150 Q 90 158 118 152" />
                            <path d="M 342 145 Q 315 132 290 138 M 315 132 Q 302 122 285 125" />
                            <path d="M 338 150 Q 310 158 282 152" />
                        </g>

                        <g id="eyeballGroup">
                            <circle cx="200" cy="145" r="56" fill="url(#detailedIris)" stroke="#f3d088" stroke-width="1.8" />

                            <g stroke="rgba(243, 208, 136, 0.34)" stroke-width="1">
                                <line x1="200" y1="89" x2="200" y2="201" />
                                <line x1="144" y1="145" x2="256" y2="145" />
                                <line x1="160" y1="105" x2="240" y2="185" />
                                <line x1="240" y1="105" x2="160" y2="185" />
                                <line x1="178" y1="93" x2="222" y2="197" />
                                <line x1="222" y1="93" x2="178" y2="197" />
                                <line x1="148" y1="123" x2="252" y2="167" />
                                <line x1="148" y1="167" x2="252" y2="123" />
                            </g>

                            <circle cx="200" cy="145" r="41" fill="none" stroke="rgba(255, 255, 255, 0.5)" stroke-width="1.2" stroke-dasharray="5 3 2 3" />
                            <circle cx="200" cy="145" r="31" fill="none" stroke="#f3d088" stroke-width="1" opacity="0.75" />

                            <g id="pupilGroup">
                                <circle cx="200" cy="145" r="21" fill="#020205" stroke="#f3d088" stroke-width="1.4" />
                                <polygon points="200,131 211,145 200,159 189,145" fill="rgba(56, 189, 248, 0.3)" />
                            </g>

                            <g id="glintGroup">
                                <ellipse cx="184" cy="128" rx="9" ry="5.5" transform="rotate(-28 184 128)" fill="#ffffff" opacity="0.94" />
                                <circle cx="176" cy="138" r="3" fill="#ffffff" opacity="0.75" />
                                <circle cx="216" cy="162" r="4" fill="#38bdf8" opacity="0.85" />
                            </g>
                        </g>

                        <path d="M 55 145 C 115 62, 285 62, 345 145 C 285 228, 115 228, 55 145 Z"
                              fill="url(#eyelidShadow)" pointer-events="none" />
                    </g>

                    <path d="M 55 145 C 115 62, 285 62, 345 145 C 285 228, 115 228, 55 145 Z"
                          fill="none" stroke="url(#goldMetal)" stroke-width="4.5" stroke-linecap="round" />
                    <path d="M 42 136 C 110 42, 290 42, 358 136"
                          fill="none" stroke="url(#goldMetal)" stroke-width="2" opacity="0.82" />
                    <path d="M 48 156 C 115 244, 285 244, 352 156"
                          fill="none" stroke="url(#goldMetal)" stroke-width="1.8" stroke-dasharray="10 5" opacity="0.75" />

                    <g stroke="url(#goldMetal)" stroke-width="2.2" stroke-linecap="round">
                        <line x1="200" y1="68" x2="200" y2="44" />
                        <line x1="165" y1="73" x2="156" y2="52" />
                        <line x1="235" y1="73" x2="244" y2="52" />
                        <line x1="132" y1="85" x2="118" y2="68" />
                        <line x1="268" y1="85" x2="282" y2="68" />
                        <line x1="100" y1="104" x2="84" y2="90" />
                        <line x1="300" y1="104" x2="316" y2="90" />
                    </g>
                </g>
            </svg>

            <div class="floating-telemetry">
                <div class="telemetry-code" id="eyeTelemetry">
                    OMNISSIAH_EYE :: X:000 Y:000 | STATUS: WATCHING
                </div>
                <div class="telemetry-sub" data-i18n="hero.eyeHint">
                    Натисніть на Око, щоб здійснити імпульс очищення
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const artifactContainer = document.getElementById('artifactContainer');
        const eyeSvg = document.getElementById('eyeSvg');
        const eyeballGroup = document.getElementById('eyeballGroup');
        const pupilGroup = document.getElementById('pupilGroup');
        const glintGroup = document.getElementById('glintGroup');
        const sacredTriangle = document.getElementById('sacredTriangle');
        const gloryRays = document.getElementById('gloryRays');
        const eyeTelemetry = document.getElementById('eyeTelemetry');

        document.addEventListener('mousemove', (e) => {
            if (!eyeSvg || !eyeballGroup) return;

            const rect = eyeSvg.getBoundingClientRect();
            const eyeCenterX = rect.left + rect.width / 2;
            const eyeCenterY = rect.top + rect.height / 2;

            const dx = e.clientX - eyeCenterX;
            const dy = e.clientY - eyeCenterY;
            const angle = Math.atan2(dy, dx);
            const rawDist = Math.hypot(dx, dy);
            const normalizedDist = Math.min(1, rawDist / 380);

            const irisX = Math.cos(angle) * normalizedDist * 44;
            const irisY = Math.sin(angle) * normalizedDist * 22;
            eyeballGroup.style.transform = `translate(${irisX}px, ${irisY}px)`;

            const pupilX = Math.cos(angle) * normalizedDist * 10;
            const pupilY = Math.sin(angle) * normalizedDist * 6;
            const pupilScale = 1 + (1 - normalizedDist) * 0.18;
            pupilGroup.style.transform = `translate(${pupilX}px, ${pupilY}px) scale(${pupilScale})`;
            pupilGroup.style.transformOrigin = '200px 145px';

            glintGroup.style.transform = `translate(${-irisX * 0.18}px, ${-irisY * 0.18}px)`;

            sacredTriangle.style.transform = `translate(${-irisX * 0.15}px, ${-irisY * 0.15}px)`;
            gloryRays.style.transform = `translate(${-irisX * 0.28}px, ${-irisY * 0.28}px)`;

            const rotX = ((e.clientY - window.innerHeight / 2) / (window.innerHeight / 2)) * -12;
            const rotY = ((e.clientX - window.innerWidth / 2) / (window.innerWidth / 2)) * 12;
            artifactContainer.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;

            eyeTelemetry.textContent = `ВСЕВИДЯЧЕ ОКО :: X:${e.clientX} Y:${e.clientY} | FOCUS:${Math.round((1 - normalizedDist) * 100)}%`;
        });

        document.addEventListener('mousedown', () => {
            if (!artifactContainer) return;
            artifactContainer.classList.add('blink');
            artifactContainer.classList.remove('pulse-wave');
            void artifactContainer.offsetWidth; 
            artifactContainer.classList.add('pulse-wave');
            setTimeout(() => artifactContainer.classList.remove('blink'), 160);
        });

        setInterval(() => {
            if (!artifactContainer) return;
            artifactContainer.classList.add('blink');
            setTimeout(() => artifactContainer.classList.remove('blink'), 150);
        }, 6000);
    </script>
}