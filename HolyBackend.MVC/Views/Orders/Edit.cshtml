@model HolyBackend.MVC.Models.CreateOrderViewModel
@{
    ViewData["Title"] = "Редагування Обряду";
    string orderCode = "#PD-" + Model.Id.ToString().Substring(0, 6).ToUpper();

    string cleanTitle = (Model.Title ?? "")
        .Replace("[Терміново] Рефакторинг: ", "")
        .Replace("[UI/UX] ", "")
        .Trim();
}

<style>
    .edit-ritual-sanctuary {
        width: 100%;
        display: grid;
        grid-template-columns: 1.18fr 0.82fr;
        gap: 2.4rem;
        align-items: start;
        padding: 0.5rem 0;
    }

    .altar-form-card {
        background: linear-gradient(180deg, rgba(14, 17, 28, 0.94) 0%, rgba(8, 10, 16, 0.98) 100%);
        border: 1px solid rgba(201, 162, 94, 0.35);
        border-radius: 20px;
        padding: 2.2rem;
        box-shadow: 0 22px 55px rgba(0, 0, 0, 0.9), inset 0 0 28px rgba(0, 0, 0, 0.75);
    }

    .ritual-crest-line {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.75rem;
        color: var(--accent-blue);
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
    }

        .ritual-crest-line::before {
            content: "";
            width: 24px;
            height: 1px;
            background: var(--primary-gold);
            box-shadow: 0 0 8px var(--primary-gold);
        }

    .type-selector-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.85rem;
        margin-top: 0.5rem;
        margin-bottom: 1.4rem;
    }

    .type-option-card {
        background: rgba(6, 8, 13, 0.88);
        border: 1px solid rgba(201, 162, 94, 0.24);
        border-radius: 12px;
        padding: 0.9rem 1rem;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .type-option-card:hover {
            border-color: rgba(201, 162, 94, 0.55);
            background: rgba(15, 19, 30, 0.92);
        }

        .type-option-card.active {
            background: linear-gradient(135deg, rgba(201, 162, 94, 0.2), rgba(56, 189, 248, 0.1));
            border-color: var(--primary-gold);
            box-shadow: 0 0 20px rgba(201, 162, 94, 0.18);
        }

    .type-option-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(5, 7, 11, 0.95);
        border: 1px solid rgba(201, 162, 94, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .type-option-card.active .type-option-icon {
        border-color: var(--accent-blue);
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
    }

    .type-option-title {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
    }

    .type-option-sub {
        font-family: 'Fira Code', monospace;
        font-size: 0.68rem;
        color: #9ca3af;
        margin-top: 2px;
    }

    .field-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.4rem;
    }

    .field-label {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        color: var(--gold-bright);
        font-size: 0.98rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .field-counter {
        font-family: 'Fira Code', monospace;
        font-size: 0.72rem;
        color: #71717a;
    }

    .holy-input,
    .holy-textarea {
        width: 100%;
        padding: 12px 15px;
        background: #06080d;
        border: 1px solid rgba(201, 162, 94, 0.3);
        color: #ffffff;
        border-radius: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.88rem;
        transition: border-color 0.25s, box-shadow 0.25s;
    }

        .holy-input:focus,
        .holy-textarea:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 16px rgba(56, 189, 248, 0.22);
        }

    .holy-textarea {
        resize: vertical;
        min-height: 150px;
        line-height: 1.6;
    }

    .field-error-msg {
        color: #f87171;
        font-size: 0.78rem;
        margin-top: 4px;
        display: block;
    }

    .btn-pray-deploy-submit {
        flex: 1;
        padding: 0.95rem 1.8rem;
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 1.12rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #f7dfa5;
        background: radial-gradient(circle at center, rgba(201, 162, 94, 0.32) 0%, rgba(15, 14, 18, 0.95) 100%);
        border: 1.5px solid var(--primary-gold);
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 0 0 28px rgba(201, 162, 94, 0.28), inset 0 0 15px rgba(201, 162, 94, 0.2);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .btn-pray-deploy-submit:hover {
            background: linear-gradient(135deg, #dfba73, #b5893e);
            color: #050609;
            box-shadow: 0 0 42px rgba(243, 208, 136, 0.65);
            transform: translateY(-2px);
        }

    .live-scroll-inspector {
        background: radial-gradient(circle at top, rgba(201, 162, 94, 0.15), rgba(9, 11, 18, 0.96) 70%);
        border: 1px solid rgba(201, 162, 94, 0.38);
        border-radius: 20px;
        padding: 1.9rem;
        position: sticky;
        top: 6rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.88), inset 0 0 25px rgba(0, 0, 0, 0.8);
    }

    .preview-scroll-box {
        background: rgba(5, 7, 11, 0.92);
        border: 1px solid rgba(201, 162, 94, 0.25);
        border-left: 3px solid var(--accent-blue);
        border-radius: 12px;
        padding: 1.1rem 1.2rem;
        margin-bottom: 1.4rem;
    }

    .preview-factory-title {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 1.2rem;
        color: #ffffff;
        font-weight: 700;
        margin: 0.35rem 0;
        word-break: break-word;
    }

    .canon-checklist {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .canon-rule-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.55rem 0.8rem;
        background: rgba(6, 8, 13, 0.82);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 8px;
        font-size: 0.78rem;
        color: #9ca3af;
        transition: all 0.25s;
    }

        .canon-rule-item.valid {
            border-color: rgba(74, 222, 128, 0.4);
            color: #e4e4e7;
            background: rgba(10, 24, 18, 0.55);
        }

    .canon-diamond {
        width: 8px;
        height: 8px;
        transform: rotate(45deg);
        background: #52525b;
        flex-shrink: 0;
        transition: all 0.25s;
    }

    .canon-rule-item.valid .canon-diamond {
        background: #4ade80;
        box-shadow: 0 0 8px #4ade80;
    }

    @@media (max-width: 1024px) {
        .edit-ritual-sanctuary {
            grid-template-columns: 1fr;
        }

        .live-scroll-inspector {
            position: static;
        }
    }

    @@media (max-width: 600px) {
        .type-selector-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="edit-ritual-sanctuary">
    <div class="altar-form-card">
        <div class="ritual-crest-line"> Correctio Scripturae • @orderCode</div>
        <h1 class="gothic-title" style="font-size: 3.1rem; margin-bottom: 0.2rem;">Редагування Заявки</h1>
        <div class="subtitle-gold" style="font-size: 1.15rem; margin-bottom: 1.4rem;">
            Внесіть зміни у параметри сувою <strong style="color: var(--accent-blue); font-style: normal; font-family: 'Fira Code', monospace; font-size: 0.95rem;">@orderCode</strong> перед повторним освяченням
        </div>

        <form asp-controller="Orders" asp-action="Edit" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Type" id="selectedOrderTypeInput" value="@Model.Type" />

            <div asp-validation-summary="All" style="color: #f87171; font-size: 0.84rem; margin-bottom: 1rem;"></div>

            <div class="field-label-row">
                <label class="field-label">I. Категорія Таїнства</label>
                <span class="field-counter" id="typeHintBadge">OrderType.@Model.Type</span>
            </div>

            <div class="type-selector-grid">
                <div class="type-option-card @(Model.Type == HolyBackend.Core.Models.OrderType.Standard ? "active" : "")"
                     onclick="selectOrderType('Standard', '', this)">
                    <div class="type-option-icon">
                        <svg style="width:22px; height:22px;" viewBox="0 0 40 40" fill="none">
                            <polygon points="20,4 35,14 35,35 5,35 5,14" stroke="#c9a25e" stroke-width="2.2" />
                            <circle cx="20" cy="21" r="5" stroke="#38bdf8" stroke-width="2" />
                        </svg>
                    </div>
                    <div>
                        <div class="type-option-title">Веб-Собор під ключ</div>
                        <div class="type-option-sub">Standard • Розробка з нуля</div>
                    </div>
                </div>

                <div class="type-option-card @(Model.Type == HolyBackend.Core.Models.OrderType.Backend ? "active" : "")"
                     onclick="selectOrderType('Backend', '', this)">
                    <div class="type-option-icon">
                        <svg style="width:22px; height:22px;" viewBox="0 0 40 40" fill="none">
                            <ellipse cx="20" cy="11" rx="13" ry="5" stroke="#38bdf8" stroke-width="2.2" />
                            <path d="M 7 11 L 7 29 C 7 33 33 33 33 29 L 33 11" stroke="#c9a25e" stroke-width="2.2" />
                        </svg>
                    </div>
                    <div>
                        <div class="type-option-title">Ядро та Бази Даних</div>
                        <div class="type-option-sub">Backend • Архітектура .NET та БД</div>
                    </div>
                </div>

                <div class="type-option-card @(Model.Type == HolyBackend.Core.Models.OrderType.Design ? "active" : "")"
                     onclick="selectOrderType('Design', '[UI/UX] ', this)">
                    <div class="type-option-icon">
                        <svg style="width:22px; height:22px;" viewBox="0 0 40 40" fill="none">
                            <circle cx="20" cy="20" r="14" stroke="#c9a25e" stroke-width="2.2" />
                            <polygon points="20,8 32,20 20,32 8,20" stroke="#38bdf8" stroke-width="1.8" />
                        </svg>
                    </div>
                    <div>
                        <div class="type-option-title">Сакральний Візуал</div>
                        <div class="type-option-sub">Design • Готичний UI/UX дизайн</div>
                    </div>
                </div>

                <div class="type-option-card @(Model.Type == HolyBackend.Core.Models.OrderType.Refactoring ? "active" : "")"
                     onclick="selectOrderType('Refactoring', '[Терміново] Рефакторинг: ', this)">
                    <div class="type-option-icon">
                        <svg style="width:22px; height:22px;" viewBox="0 0 40 40" fill="none">
                            <line x1="20" y1="5" x2="20" y2="35" stroke="#f3d088" stroke-width="2.5" />
                            <path d="M 11 14 L 20 18 L 29 14" stroke="#38bdf8" stroke-width="2.2" />
                        </svg>
                    </div>
                    <div>
                        <div class="type-option-title">Екзорцизм Багів</div>
                        <div class="type-option-sub">Refactoring • Терміновий</div>
                    </div>
                </div>
            </div>

            <div style="margin-bottom: 1.2rem;">
                <div class="field-label-row">
                    <label asp-for="Title" class="field-label">II. Назва Проєкту (5 – 100 символів)</label>
                    <span class="field-counter" id="titleLenCounter">0 / 100</span>
                </div>
                <input asp-for="Title" id="orderTitleInput" value="@cleanTitle" class="holy-input"
                       maxlength="100" oninput="validateLiveCanon()" required />
                <span asp-validation-for="Title" class="field-error-msg"></span>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <div class="field-label-row">
                    <label asp-for="Description" class="field-label">III. Опис Завдання</label>
                    <span class="field-counter" id="descLenCounter">0 / 2000</span>
                </div>
                <textarea asp-for="Description" id="orderDescInput" rows="5" class="holy-textarea"
                          maxlength="2000" oninput="validateLiveCanon()" required></textarea>
                <span asp-validation-for="Description" class="field-error-msg"></span>
            </div>

            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                <button type="submit" class="btn-pray-deploy-submit">
                    <span>Молитися і Оновити Деплой</span>
                    <span style="color: var(--accent-blue);">✦</span>
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-danger" style="padding: 0.92rem 1.8rem; font-size: 1rem;">
                    Скасувати
                </a>
            </div>
        </form>
    </div>

    <aside class="live-scroll-inspector">
        <div class="ritual-crest-line">Validatio Fluentis</div>
        <h3 style="font-family: 'Cormorant Unicase', 'Cinzel', serif; font-size: 1.45rem; color: var(--gold-bright); margin-bottom: 0.3rem;">
            Оновлений Сувій
        </h3>
        <p style="font-size: 0.8rem; color: #9ca3af; margin-bottom: 1rem;">
            Попередній перегляд сувою після форматування фабрикою <code>OrderFactory</code>:
        </p>

        <div class="preview-scroll-box">
            <div style="display: flex; justify-content: space-between; font-family: 'Fira Code', monospace; font-size: 0.72rem; color: var(--accent-blue);">
                <span>@orderCode</span>
                <span id="previewTypeLabel">@Model.Type</span>
            </div>
            <div class="preview-factory-title" id="previewTitleText">@Model.Title</div>
            <div id="previewDescText" style="font-size: 0.8rem; color: #9ca3af; line-height: 1.5; max-height: 85px; overflow: hidden;">
                @Model.Description
            </div>
        </div>

        <div style="font-family: 'Cinzel', serif; font-size: 0.75rem; color: var(--primary-gold); letter-spacing: 1px; margin-bottom: 0.65rem;">
            ПЕРЕВІРКА КАНОНІВ (ORDERVALIDATOR):
        </div>

        <div class="canon-checklist">
            <div class="canon-rule-item" id="ruleTitleLen">
                <span class="canon-diamond"></span>
                <span>Довжина назви від 5 до 100 осмислених символів</span>
            </div>
            <div class="canon-rule-item valid" id="ruleNoCaps">
                <span class="canon-diamond"></span>
                <span>Спокійний тон без крику (вимкнено Caps Lock)</span>
            </div>
            <div class="canon-rule-item" id="ruleDescLen">
                <span class="canon-diamond"></span>
                <span id="ruleDescLenText">Опис містить щонайменше 20 символів</span>
            </div>
            <div class="canon-rule-item valid" id="ruleBackendTech" style="display: none;">
                <span class="canon-diamond"></span>
                <span>Для Backend вказано контекст (БД, SQL, API, .NET, сервер)</span>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script>
        let currentType = '@Model.Type';
        let currentPrefix = currentType === 'Design'
            ? '[UI/UX] '
            : (currentType === 'Refactoring' ? '[Терміново] Рефакторинг: ' : '');

        function selectOrderType(typeVal, prefix, cardEl) {
            currentType = typeVal;
            currentPrefix = prefix;

            document.getElementById('selectedOrderTypeInput').value = typeVal;
            document.getElementById('typeHintBadge').textContent = 'OrderType.' + typeVal;
            document.getElementById('previewTypeLabel').textContent = typeVal;

            document.querySelectorAll('.type-option-card').forEach(c => c.classList.remove('active'));
            cardEl.classList.add('active');

            validateLiveCanon();
        }

        function setRuleState(id, isValid) {
            const el = document.getElementById(id);
            if (!el) return;
            if (isValid) el.classList.add('valid');
            else el.classList.remove('valid');
        }

        function validateLiveCanon() {
            const rawTitle = (document.getElementById('orderTitleInput')?.value || '').trim();
            const rawDesc = (document.getElementById('orderDescInput')?.value || '').trim();

            document.getElementById('titleLenCounter').textContent = `${rawTitle.length} / 100`;
            document.getElementById('descLenCounter').textContent = `${rawDesc.length} / 2000`;

            const previewTitle = document.getElementById('previewTitleText');
            previewTitle.textContent = rawTitle ? (currentPrefix + rawTitle) : 'Очікування назви обряду...';

            const previewDesc = document.getElementById('previewDescText');
            previewDesc.textContent = rawDesc || 'Опис завдання порожній...';

            const distinctChars = new Set(rawTitle.toLowerCase()).size;
            setRuleState('ruleTitleLen', rawTitle.length >= 5 && rawTitle.length <= 100 && distinctChars >= 3);

            const letters = rawTitle.match(/[a-zA-Zа-яА-ЯіІїЇєЄґҐ]/g) || [];
            const hasLower = letters.some(ch => ch === ch.toLowerCase() && ch !== ch.toUpperCase());
            setRuleState('ruleNoCaps', letters.length < 5 || hasLower);

            const minDesc = currentType === 'Refactoring' ? 35 : 20;
            document.getElementById('ruleDescLenText').textContent =
                `Опис містить щонайменше ${minDesc} символів (зараз: ${rawDesc.length})`;
            setRuleState('ruleDescLen', rawDesc.length >= minDesc);

            const backendRuleEl = document.getElementById('ruleBackendTech');
            if (currentType === 'Backend') {
                backendRuleEl.style.display = 'flex';
                const keywords = ['бд', 'баз', 'sql', 'api', 'сервер', 'бекенд', 'backend', 'логік', 'архітектур', '.net', 'c#', 'таблиц', 'даних', 'сайт', 'систем'];
                const lowerDesc = rawDesc.toLowerCase();
                const hasTech = keywords.some(k => lowerDesc.includes(k));
                setRuleState('ruleBackendTech', hasTech);
            } else {
                backendRuleEl.style.display = 'none';
            }
        }

        validateLiveCanon();
    </script>
}