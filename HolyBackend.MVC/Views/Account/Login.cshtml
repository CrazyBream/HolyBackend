@model HolyBackend.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Вхід у Храм";
}

<style>
    .auth-sanctuary-wrap {
        max-width: 500px;
        width: 100%;
        margin: 0 auto;
        padding: 0.5rem 0;
    }

    .auth-gate-card {
        position: relative;
        background: radial-gradient(circle at 50% 0%, rgba(201, 162, 94, 0.16), rgba(9, 11, 18, 0.96) 68%);
        border: 1px solid rgba(201, 162, 94, 0.38);
        border-radius: 22px;
        padding: 2.4rem 2.2rem 2rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.92), inset 0 0 30px rgba(0, 0, 0, 0.8);
        overflow: hidden;
    }

    .gate-sigil-wrap {
        width: 78px;
        height: 78px;
        margin: 0 auto 1rem;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .gate-sigil-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1px dashed rgba(201, 162, 94, 0.55);
        box-shadow: 0 0 25px rgba(56, 189, 248, 0.18), inset 0 0 15px rgba(201, 162, 94, 0.18);
        animation: spinGateRing 36s linear infinite;
    }

    .gate-sigil-svg {
        width: 42px;
        height: 42px;
        filter: drop-shadow(0 0 10px rgba(201, 162, 94, 0.45));
        z-index: 2;
    }

    .inquisition-quick-seals {
        background: rgba(5, 7, 12, 0.9);
        border: 1px solid rgba(201, 162, 94, 0.22);
        border-radius: 12px;
        padding: 0.85rem 1rem;
        margin-bottom: 1.5rem;
    }

    .quick-seals-label {
        font-family: 'Cinzel', serif;
        font-size: 0.68rem;
        color: #9ca3af;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        margin-bottom: 0.55rem;
    }

    .quick-seals-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.55rem;
    }

    .seal-preset-btn {
        background: rgba(14, 17, 28, 0.9);
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 8px;
        padding: 0.48rem 0.6rem;
        color: #e4e4e7;
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 0.84rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.22s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .seal-preset-btn:hover {
            border-color: var(--primary-gold);
            color: var(--gold-bright);
            background: rgba(201, 162, 94, 0.14);
            box-shadow: 0 0 14px rgba(201, 162, 94, 0.2);
        }

    .auth-field-label {
        display: block;
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        color: var(--gold-bright);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .auth-input-wrap {
        position: relative;
    }

    .auth-field {
        width: 100%;
        padding: 12px 42px 12px 14px;
        background: #06080d;
        border: 1px solid rgba(201, 162, 94, 0.3);
        color: #ffffff;
        border-radius: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.88rem;
        transition: border-color 0.25s, box-shadow 0.25s;
    }

        .auth-field:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 16px rgba(56, 189, 248, 0.22);
        }

    .toggle-pass-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #71717a;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }

        .toggle-pass-btn:hover {
            color: var(--gold-bright);
        }

    .field-error {
        color: #f87171;
        font-size: 0.76rem;
        margin-top: 4px;
        display: block;
    }

    .btn-gate-submit {
        width: 100%;
        padding: 0.92rem 1.8rem;
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 1.14rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #f7dfa5;
        background: radial-gradient(circle at center, rgba(201, 162, 94, 0.3) 0%, rgba(15, 14, 18, 0.95) 100%);
        border: 1.5px solid var(--primary-gold);
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 0 0 25px rgba(201, 162, 94, 0.25), inset 0 0 14px rgba(201, 162, 94, 0.18);
        transition: all 0.3s ease;
    }

        .btn-gate-submit:hover {
            background: linear-gradient(135deg, #dfba73, #b5893e);
            color: #050609;
            box-shadow: 0 0 38px rgba(243, 208, 136, 0.65);
            transform: translateY(-2px);
        }

    @@keyframes spinGateRing {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="auth-sanctuary-wrap">
    <div class="auth-gate-card">
        <div class="gate-sigil-wrap">
            <div class="gate-sigil-ring"></div>
            <svg class="gate-sigil-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <polygon points="20,4 36,20 20,36 4,20" fill="none" stroke="#c9a25e" stroke-width="2" />
                <circle cx="20" cy="16" r="4.5" fill="none" stroke="#38bdf8" stroke-width="2" />
                <line x1="20" y1="20.5" x2="20" y2="30" stroke="#f3d088" stroke-width="2.2" stroke-linecap="round" />
                <line x1="20" y1="26" x2="24" y2="26" stroke="#f3d088" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>

        <h1 class="gothic-title" style="font-size: 3rem; text-align: center; margin-bottom: 0.2rem;">Вхід в Орден</h1>
        <div class="subtitle-gold" style="text-align: center; font-size: 1.12rem; margin-bottom: 1.3rem;">
            Пред'явіть ваші ключі доступу перед Брамою Храму
        </div>

        <form asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 1.15rem;">
                <label asp-for="Email" class="auth-field-label">Електронна пошта (Email)</label>
                <div class="auth-input-wrap">
                    <input asp-for="Email" id="loginEmail" class="auth-field" style="padding-right: 14px;" placeholder="name@prayanddeploy.com" required />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div style="margin-bottom: 1.15rem;">
                <label asp-for="Password" class="auth-field-label">Таємний пароль</label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" id="loginPassword" type="password" class="auth-field" placeholder="••••••••" required />
                    <button type="button" class="toggle-pass-btn" onclick="togglePassword('loginPassword', this)" title="Показати / приховати пароль">
                        <svg style="width:18px; height:18px; stroke:currentColor;" viewBox="0 0 24 24" fill="none" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; font-size: 0.83rem;">
                <label style="display: flex; align-items: center; gap: 9px; cursor: pointer; color: #cbd5e1;">
                    <input asp-for="RememberMe" type="checkbox" style="accent-color: var(--primary-gold); width: 16px; height: 16px; cursor: pointer;" />
                    <span>Запам'ятати мою печатку на 14 днів</span>
                </label>
            </div>

            <button type="submit" class="btn-gate-submit">
                Увійти в Кабінет ✦
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.4rem; font-size: 0.85rem; border-top: 1px solid rgba(201,162,94,0.18); padding-top: 1.1rem; color: #9ca3af;">
            Ще не прийняли присягу?
            <a asp-action="Register" style="color: var(--accent-blue); text-decoration: none; font-family: 'Cormorant Unicase', serif; font-weight: 700; font-size: 0.95rem; margin-left: 4px;">
                Прийняти Присягу Парафіянина →
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            btn.style.color = input.type === 'text' ? 'var(--accent-blue)' : '#71717a';
        }

        function fillInquisitor(email, pass) {
            const emailEl = document.getElementById('loginEmail');
            const passEl = document.getElementById('loginPassword');
            if (emailEl && passEl) {
                emailEl.value = email;
                passEl.value = pass;
                emailEl.style.borderColor = 'var(--primary-gold)';
                passEl.style.borderColor = 'var(--primary-gold)';
            }
        }
    </script>
}