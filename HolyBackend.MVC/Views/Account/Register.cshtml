@model HolyBackend.MVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Присяга Парафіянина";
}

<style>
    .register-sanctuary-wrap {
        max-width: 540px;
        width: 100%;
        margin: 0 auto;
        padding: 0.5rem 0;
    }

    .oath-altar-card {
        position: relative;
        background: radial-gradient(circle at 50% 0%, rgba(201, 162, 94, 0.16), rgba(9, 11, 18, 0.96) 68%);
        border: 1px solid rgba(201, 162, 94, 0.38);
        border-radius: 22px;
        padding: 2.3rem 2.2rem 2rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.92), inset 0 0 30px rgba(0, 0, 0, 0.8);
        overflow: hidden;
    }

    .oath-sigil-wrap {
        width: 76px;
        height: 76px;
        margin: 0 auto 0.9rem;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .oath-sigil-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1px dashed rgba(201, 162, 94, 0.55);
        box-shadow: 0 0 25px rgba(56, 189, 248, 0.18), inset 0 0 15px rgba(201, 162, 94, 0.18);
        animation: spinOathRing 38s linear infinite;
    }

    .oath-sigil-svg {
        width: 42px;
        height: 42px;
        filter: drop-shadow(0 0 10px rgba(201, 162, 94, 0.45));
        z-index: 2;
    }

    .neophyte-live-badge {
        background: rgba(5, 7, 12, 0.9);
        border: 1px solid rgba(201, 162, 94, 0.24);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .neophyte-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .neophyte-monogram {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(14, 17, 28, 0.95);
        border: 1px solid var(--primary-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 1rem;
        color: var(--gold-bright);
        flex-shrink: 0;
    }

    .neophyte-name {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .neophyte-rank {
        font-family: 'Fira Code', monospace;
        font-size: 0.68rem;
        color: var(--accent-blue);
        padding: 3px 9px;
        border-radius: 50px;
        background: rgba(56, 189, 248, 0.08);
        border: 1px solid rgba(56, 189, 248, 0.3);
        white-space: nowrap;
    }

    .auth-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .auth-field-label {
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        color: var(--gold-bright);
        font-size: 0.94rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .auth-hint {
        font-family: 'Fira Code', monospace;
        font-size: 0.7rem;
        color: #71717a;
    }

    .auth-input-wrap {
        position: relative;
    }

    .auth-field {
        width: 100%;
        padding: 12px 42px 12px 14px;
        background: #06080d;
        border: 1px solid rgba(201, 162, 94, 0.3);
        color: #ffffff;
        border-radius: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.88rem;
        transition: border-color 0.25s, box-shadow 0.25s;
    }

        .auth-field:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 16px rgba(56, 189, 248, 0.22);
        }

    .toggle-pass-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #71717a;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }

        .toggle-pass-btn:hover {
            color: var(--gold-bright);
        }

    .field-error {
        color: #f87171;
        font-size: 0.76rem;
        margin-top: 4px;
        display: block;
    }

    .pass-strength-bars {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 5px;
        margin-top: 7px;
    }

    .pass-bar-seg {
        height: 4px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        transition: background 0.25s;
    }

    .btn-oath-submit {
        width: 100%;
        padding: 0.92rem 1.8rem;
        font-family: 'Cormorant Unicase', 'Cinzel', serif;
        font-size: 1.14rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #f7dfa5;
        background: radial-gradient(circle at center, rgba(201, 162, 94, 0.3) 0%, rgba(15, 14, 18, 0.95) 100%);
        border: 1.5px solid var(--primary-gold);
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 0 0 25px rgba(201, 162, 94, 0.25), inset 0 0 14px rgba(201, 162, 94, 0.18);
        transition: all 0.3s ease;
    }

        .btn-oath-submit:hover {
            background: linear-gradient(135deg, #dfba73, #b5893e);
            color: #050609;
            box-shadow: 0 0 38px rgba(243, 208, 136, 0.65);
            transform: translateY(-2px);
        }

    @@keyframes spinOathRing {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="register-sanctuary-wrap">
    <div class="oath-altar-card">
        <div class="oath-sigil-wrap">
            <div class="oath-sigil-ring"></div>
            <svg class="oath-sigil-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <polygon points="20,4 35,32 5,32" fill="none" stroke="#c9a25e" stroke-width="2" />
                <circle cx="20" cy="21" r="6" fill="none" stroke="#38bdf8" stroke-width="1.8" />
                <circle cx="20" cy="21" r="2" fill="#f3d088" />
            </svg>
        </div>

        <h1 class="gothic-title" style="font-size: 3rem; text-align: center; margin-bottom: 0.2rem;">Новий Парафіянин</h1>
        <div class="subtitle-gold" style="text-align: center; font-size: 1.1rem; margin-bottom: 1.2rem;">
            Прийміть присягу Ордену, щоб ініціювати обряди та спілкуватися з Інквізицією
        </div>

        <div class="neophyte-live-badge">
            <div class="neophyte-left">
                <div class="neophyte-monogram" id="liveRegMonogram">Б</div>
                <div>
                    <div class="neophyte-name" id="liveRegName">Брат Архітектор</div>
                    <div id="liveRegEmail" style="font-family: 'Fira Code', monospace; font-size: 0.72rem; color: #71717a;">sinner@domain.com</div>
                </div>
            </div>
            <span class="neophyte-rank">✦ Новачок Ордену</span>
        </div>

        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 1.05rem;">
                <div class="auth-label-row">
                    <label asp-for="UserName" class="auth-field-label">Ваше ім'я або назва компанії</label>
                    <span class="auth-hint" id="regNameCounter">0 / 50</span>
                </div>
                <div class="auth-input-wrap">
                    <input asp-for="UserName" id="regUserNameInput" class="auth-field" style="padding-right: 14px;"
                           placeholder="Брат Архітектор" maxlength="50" oninput="updateNeophyteCard()" required />
                </div>
                <span asp-validation-for="UserName" class="field-error"></span>
            </div>

            <div style="margin-bottom: 1.05rem;">
                <div class="auth-label-row">
                    <label asp-for="Email" class="auth-field-label">Електронна пошта (Email)</label>
                    <span class="auth-hint">Логін у Храмі</span>
                </div>
                <div class="auth-input-wrap">
                    <input asp-for="Email" id="regEmailInput" class="auth-field" style="padding-right: 14px;"
                           placeholder="sinner@domain.com" oninput="updateNeophyteCard()" required />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div style="margin-bottom: 1.05rem;">
                <div class="auth-label-row">
                    <label asp-for="Password" class="auth-field-label">Таємний пароль (мін. 6 символів)</label>
                    <span class="auth-hint" id="regStrengthLabel">Очікування...</span>
                </div>
                <div class="auth-input-wrap">
                    <input asp-for="Password" id="regPass" type="password" class="auth-field"
                           placeholder="••••••••" oninput="checkRegPasswords()" required />
                    <button type="button" class="toggle-pass-btn" onclick="toggleRegPass('regPass', this)" title="Показати / приховати">
                        <svg style="width:18px; height:18px; stroke:currentColor;" viewBox="0 0 24 24" fill="none" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <div class="pass-strength-bars">
                    <div class="pass-bar-seg" id="rSeg1"></div>
                    <div class="pass-bar-seg" id="rSeg2"></div>
                    <div class="pass-bar-seg" id="rSeg3"></div>
                    <div class="pass-bar-seg" id="rSeg4"></div>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <div class="auth-label-row">
                    <label asp-for="ConfirmPassword" class="auth-field-label">Повторіть пароль</label>
                    <span class="auth-hint" id="regMatchLabel"></span>
                </div>
                <div class="auth-input-wrap">
                    <input asp-for="ConfirmPassword" id="regConfirmPass" type="password" class="auth-field"
                           placeholder="••••••••" oninput="checkRegPasswords()" required />
                    <button type="button" class="toggle-pass-btn" onclick="toggleRegPass('regConfirmPass', this)" title="Показати / приховати">
                        <svg style="width:18px; height:18px; stroke:currentColor;" viewBox="0 0 24 24" fill="none" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-oath-submit">
                Прийняти Присягу ✦
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.35rem; font-size: 0.85rem; border-top: 1px solid rgba(201,162,94,0.18); padding-top: 1.05rem; color: #9ca3af;">
            Вже маєте печатку Ордену?
            <a asp-action="Login" style="color: var(--accent-blue); text-decoration: none; font-family: 'Cormorant Unicase', serif; font-weight: 700; font-size: 0.95rem; margin-left: 4px;">
                Увійти в Храм →
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleRegPass(id, btn) {
            const el = document.getElementById(id);
            if (!el) return;
            el.type = el.type === 'password' ? 'text' : 'password';
            btn.style.color = el.type === 'text' ? 'var(--accent-blue)' : '#71717a';
        }

        function updateNeophyteCard() {
            const nameVal = (document.getElementById('regUserNameInput')?.value || '').trim();
            const emailVal = (document.getElementById('regEmailInput')?.value || '').trim();

            document.getElementById('regNameCounter').textContent = `${nameVal.length} / 50`;
            document.getElementById('liveRegName').textContent = nameVal || 'Брат Архітектор';
            document.getElementById('liveRegEmail').textContent = emailVal || 'sinner@domain.com';
            document.getElementById('liveRegMonogram').textContent = nameVal ? nameVal.charAt(0).toUpperCase() : 'Б';
        }

        function checkRegPasswords() {
            const pass = document.getElementById('regPass')?.value || '';
            const conf = document.getElementById('regConfirmPass')?.value || '';

            let score = 0;
            if (pass.length >= 6) score++;
            if (pass.length >= 10) score++;
            if (/[A-ZА-ЯІЇЄҐ]/.test(pass) && /[0-9]/.test(pass)) score++;
            if (/[^A-Za-zА-Яа-яІіЇїЄєҐґ0-9]/.test(pass)) score++;

            const colors = ['#ef4444', '#facc15', '#38bdf8', '#4ade80'];
            const labels = ['Слабкий ключ', 'Прийнятний', 'Надійний', 'Непорушний шифр'];

            for (let i = 1; i <= 4; i++) {
                const seg = document.getElementById('rSeg' + i);
                seg.style.background = i <= score ? colors[score - 1] : 'rgba(255,255,255,0.08)';
            }

            const strLbl = document.getElementById('regStrengthLabel');
            strLbl.textContent = pass.length > 0 ? labels[Math.max(0, score - 1)] : 'Очікування...';
            strLbl.style.color = pass.length > 0 ? colors[Math.max(0, score - 1)] : '#71717a';

            const matchLbl = document.getElementById('regMatchLabel');
            if (!conf) {
                matchLbl.textContent = '';
            } else if (pass === conf) {
                matchLbl.textContent = 'Ключі збігаються';
                matchLbl.style.color = '#4ade80';
            } else {
                matchLbl.textContent = 'Паролі не збігаються';
                matchLbl.style.color = '#f87171';
            }
        }
    </script>
}